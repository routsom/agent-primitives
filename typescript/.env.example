# Leave all unset to run entirely on the mock provider (default, no network calls).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Which provider to use when a key is available. One of: anthropic | openai | google | mock
DEFAULT_PROVIDER=mock

# Harness hard caps (see specs/agents/*.json for per-role defaults these override).
MAX_SUBAGENTS=8
MAX_DELEGATION_DEPTH=2
MAX_TOOL_CALLS_PER_SUBAGENT=15
# Session-level token ceiling shared across the whole run (lead + all subagents). 0 = unlimited.
MAX_RUN_TOKENS=250000

# Provider resilience: per-call timeout, transient-error retries, and backoff base (ms).
MODEL_TIMEOUT_MS=60000
MAX_MODEL_RETRIES=2
RETRY_BASE_DELAY_MS=500

# Local artifact store root.
ARTIFACT_STORE_DIR=.artifacts

# A2A server: bearer token required on inbound tasks (unset = unauthenticated, dev only).
A2A_AUTH_TOKEN=
