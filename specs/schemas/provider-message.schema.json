{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-primitives.dev/specs/schemas/provider-message.schema.json",
  "title": "ProviderMessage",
  "description": "Normalized chat message shape all provider adapters (providers/) must produce and accept, regardless of vendor wire format.",
  "type": "object",
  "required": ["role", "content"],
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "string",
      "enum": ["system", "user", "assistant", "tool"]
    },
    "content": {
      "type": "array",
      "items": { "$ref": "#/$defs/contentBlock" },
      "minItems": 1
    },
    "name": {
      "type": "string",
      "description": "Optional agent/role name, used in multi-agent transcripts for readability."
    }
  },
  "$defs": {
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "id", "name", "input"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "tool_call" },
            "id": { "type": "string", "description": "Provider-issued call id, echoed back in the matching tool_result." },
            "name": { "type": "string" },
            "input": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["type", "toolCallId", "output"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "tool_result" },
            "toolCallId": { "type": "string" },
            "output": {},
            "isError": { "type": "boolean", "default": false }
          }
        }
      ]
    }
  }
}
